# [c]heck [o]ut
alias co='git checkout'
# [f]uzzy check[o]ut
fo() {
  git branch --no-color --sort=-committerdate --format='%(refname:short)' | fzf --header 'git checkout' | xargs git checkout
}
# [p]ull request check[o]ut
po() {
  local selected
  selected=$(gh pr list --author "@me" --json number,title,headRefName,state,isDraft \
    --jq '.[] | "\(if .isDraft then "[DRAFT]" elif .state == "OPEN" then "[OPEN]" else "[\(.state)]" end)\t#\(.number)\t\(.title)\t\(.headRefName)"' | \
    fzf --header 'checkout PR' --delimiter='\t' --with-nth=1,2,3 \
        --color='header:italic,fg+:bold' \
        --preview='echo "Branch: {4}"' \
        --preview-window='down:1')
  [[ -n "$selected" ]] && echo "$selected" | cut -f4 | xargs git checkout
}
